# ── Supabase (browser — safe to expose) ─────────────────────────
VITE_SUPABASE_URL=            # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=       # anon / publishable key

# ── Supabase (server) ───────────────────────────────────────────
DATABASE_URL=                 # Transaction pooler: postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_MIGRATIONS=      # (optional) session pooler :5432 or direct URL, for drizzle-kit
SUPABASE_URL=                 # same as VITE_SUPABASE_URL (JWKS verification)
SUPABASE_JWT_SECRET=          # (optional) legacy HS256 JWT secret; leave empty to verify via JWKS

# ── App ──────────────────────────────────────────────────────────
APP_URL=                      # https://markcitadel.com (no trailing slash)
OWNER_EMAIL=                  # your login email — gets admin + owner panels
USPTO_ODP_API_KEY=            # official USPTO Open Data Portal key (data.uspto.gov/apikey)

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=        # whsec_... for https://<site>/api/stripe/webhook
STRIPE_PRICE_PRO=             # price_... recurring $29/month
STRIPE_PRICE_REPORT=          # price_... one-time $29
